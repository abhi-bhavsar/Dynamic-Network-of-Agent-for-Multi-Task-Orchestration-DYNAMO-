# ── GROQ ───────────────────────────────────────────

# Get your API key from the Groq console
GROQ_API_KEY=your_groq_api_key_here

# Example model
GROQ_MODEL=openai/gpt-oss-20b


# ── LangSmith (Optional - for tracing) ─────────────

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=dynamo-dev


# ── App Settings ───────────────────────────────────

APP_NAME=DYNAMO
DEBUG=true
LOG_LEVEL=INFO


# ── API Settings ───────────────────────────────────

API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501


# ── Database Settings ──────────────────────────────

DATABASE_URL=postgresql://postgres:your_database_password@localhost:5432/dynamo_db